# Names and safe example values only. Set production values with DeepSpace secrets.
# Required for live observation and reasoning
NEW_RELIC_USER_KEY=
NEW_RELIC_ACCOUNT_ID=
# Optional legacy metadata only; fleet discovery uses account-level hostname facets.
NEW_RELIC_ENTITY_GUID=
NEW_RELIC_REGION=US
NEW_RELIC_RESOURCE_ID=
NEW_RELIC_FLEET_PREFIX=avmos-node-
GROK_API_KEY=
GROK_MODEL=grok-4-fast-reasoning
GROK_BASE_URL=https://api.x.ai/v1

# Optional external research
TAVILY_API_KEY=

# Required destination for all settlements; a real XRPL Testnet classic address
XRPL_VENDOR_DESTINATION=
XRPL_EXECUTION_MODE=simulated
XRPL_TESTNET_URL=wss://s.altnet.rippletest.net:51233
XRPL_WALLET_SECRET=
XRPL_RLUSD_ISSUER=
XRPL_RLUSD_CURRENCY=RLUSD

# Optional explicit selector; otherwise exactly one applicable enabled policy is required
ACTIVE_POLICY_ID=

# Production defaults
AUTONOMOUS_RUNS_ENABLED=false
DEMO_MODE=false
ALLOW_DEBUG_ROUTES=false

# Bounded DeepSpace record retention
TELEMETRY_RAW_RETENTION_DAYS=7
TELEMETRY_AGGREGATE_RETENTION_DAYS=30
OPERATIONS_LOG_RETENTION_DAYS=7
ACTION_RETENTION_DAYS=30
POLICY_DECISION_RETENTION_DAYS=90
ALERT_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=180
RETENTION_DELETE_BATCH_SIZE=500
