# Names and safe example values only. Set production values with DeepSpace secrets.
# Required for live observation and reasoning
NEW_RELIC_USER_KEY=
NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_ENTITY_GUID=
NEW_RELIC_REGION=US
NEW_RELIC_RESOURCE_ID=avmos
GROK_API_KEY=
GROK_MODEL=grok-4-fast-reasoning
GROK_BASE_URL=https://api.x.ai/v1

# Optional external research
TAVILY_API_KEY=

# Required destination for all settlements; a real XRPL Testnet classic address
XRPL_VENDOR_DESTINATION=
XRPL_EXECUTION_MODE=simulated
XRPL_TESTNET_URL=wss://s.altnet.rippletest.net:51233
XRPL_WALLET_SECRET=
XRPL_RLUSD_ISSUER=
XRPL_RLUSD_CURRENCY=RLUSD

# Optional explicit policy selector; otherwise exactly one enabled policy is required
ACTIVE_POLICY_ID=

# Production defaults
AUTONOMOUS_RUNS_ENABLED=false
DEMO_MODE=false
ALLOW_DEBUG_ROUTES=false
